# Copy to .env and fill in. Required: OPENAI_API_KEY and one Claude sign-in.

OPENAI_API_KEY=

# Claude, for the agent. Set ONE of these:
#   CLAUDE_CODE_OAUTH_TOKEN  your Claude plan (from `claude setup-token`)
#   ANTHROPIC_API_KEY        an API key from platform.claude.com, billed per use
CLAUDE_CODE_OAUTH_TOKEN=
# ANTHROPIC_API_KEY=

# GitHub, for git and gh: a fine-grained token for the repositories Alfred may work in
# (Contents and Pull requests: read and write), with an expiry. Empty: no GitHub.
ALFRED_GITHUB_TOKEN=

# Models (defaults shown)
ALFRED_LIVE_MODEL=gpt-live-1
ALFRED_DELEGATE_MODEL=gpt-6-luna
ALFRED_AGENT_MODEL=claude-haiku-5-5
# A safety stop for work that goes round in circles (agent turns per task).
ALFRED_AGENT_MAX_TURNS=200
# The library (upload files at <apps page>/library): the largest file (MB), the whole
# library (GB; the card always keeps 10 GB free), the model that reads scanned pages and
# images (empty: the agent's model), how many scanned pages in one file before Alfred asks
# first, how many he reads a day at most, and the model for meaning search.
ALFRED_LIBRARY_MAX_MB=4096
ALFRED_LIBRARY_MAX_GB=64
ALFRED_VISION_MODEL=
ALFRED_VISION_ASK_PAGES=10000
ALFRED_VISION_DAILY_PAGES=20000
# Pictures in one Claude call, and Claude calls at once: more is faster, until your Claude
# plan's rate limit says no (the log shows it).
ALFRED_VISION_PER_CALL=8
ALFRED_VISION_AT_ONCE=4
ALFRED_EMBEDDING_MODEL=text-embedding-3-large
# GPT-Live's voice: vesper is the built-in British voice. Empty lets OpenAI choose.
ALFRED_VOICE=vesper

# Where you are, and where Alfred keeps his memory, skills and projects.
ALFRED_HOME=Manila, Philippines
ALFRED_TIMEZONE=Asia/Manila
ALFRED_DATA=~/.alfred

# The apps page (what Alfred built: apps, sites, pages) on your network, at
# http://<this computer>.local:<port>/. Empty: off.
ALFRED_WEB_PORT=8080

# Music (optional): a Spotify app's Client ID from developer.spotify.com (needs Premium),
# then `uv run alfred-connect spotify`. SPOTIFY_SPEAKER: the speaker to play on, e.g. the
# Pi's Raspotify name; empty plays on the one already playing.
SPOTIFY_CLIENT_ID=
SPOTIFY_SPEAKER=

# Calendar and email (optional, read-only): a Google Cloud "Desktop app" OAuth client,
# then `uv run alfred-connect google`. See README: Music, calendar and email.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Wake word: 0 to 1. Raise it if Alfred wakes by mistake, lower it if he misses you.
ALFRED_WAKE_THRESHOLD=0.5
# Empty uses the project's models/ folder.
ALFRED_WAKEWORD_DIR=

# Close the conversation after this many seconds with nobody speaking.
ALFRED_IDLE_SECONDS=25

# Audio devices: an index or part of a name from `uv run python -m sounddevice`.
ALFRED_INPUT_DEVICE=
ALFRED_OUTPUT_DEVICE=
ALFRED_ECHO_CANCELLATION=on

# What the terminal shows (every run also writes a full DEBUG log to logs/).
ALFRED_LOG_LEVEL=INFO
